@startuml BloodConnectHub - Admin Use Case Diagram

!define RECTANGLE class

skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false
skinparam backgroundColor #FEFEFE

title BloodConnectHub - Admin Use Case Diagram

' ============================================
' Actors
' ============================================
:Admin: as admin
actor "Reporting System" as reportingSystem
actor "Notification System" as notificationSystem

' ============================================
' Use Cases - Authentication & Profile
' ============================================
package "Authentication & Profile" #FFEBEE {
  usecase "Login as Admin" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "View Admin Profile" as UC_ViewProfile
  usecase "Update Profile" as UC_UpdateProfile
  usecase "Change Password" as UC_ChangePassword
}

' ============================================
' Use Cases - Dashboard & Overview
' ============================================
package "Admin Dashboard" #E8EAF6 {
  usecase "View Admin Dashboard" as UC_AdminDashboard
  usecase "View System Statistics" as UC_SystemStats
  usecase "View Active Donors Count" as UC_ActiveDonors
  usecase "View Donations This Month" as UC_DonationsMonth
  usecase "View Pending Requests" as UC_PendingRequests
  usecase "View Emergency Requests" as UC_EmergencyRequests
  usecase "View Inventory Status" as UC_InventoryStatus
  usecase "View Expiring Units Alert" as UC_ExpiringAlert
  usecase "View Low Stock Alerts" as UC_LowStockAlert
}

' ============================================
' Use Cases - User Management
' ============================================
package "User Management" #E1F5FE {
  usecase "Manage Users" as UC_ManageUsers
  usecase "View All Users" as UC_ViewUsers
  usecase "Search Users" as UC_SearchUsers
