  usecase "Create Announcement" as UC_CreateAnnouncement
  usecase "Notify Eligible Donors" as UC_NotifyEligibleDonors
  usecase "Send Emergency Alerts" as UC_EmergencyAlerts
  usecase "View Notification History" as UC_NotificationHistory
}

' ============================================
' Use Cases - Audit & Security
' ============================================
package "Audit & Security" #FFCCBC {
  usecase "View Audit Logs" as UC_AuditLogs
  usecase "Track User Actions" as UC_TrackActions
  usecase "View Login History" as UC_LoginHistory
  usecase "Monitor System Security" as UC_MonitorSecurity
  usecase "Review Data Changes" as UC_ReviewChanges
  usecase "Export Audit Reports" as UC_ExportAudit
  usecase "Configure Security Policies" as UC_SecurityPolicies
}

