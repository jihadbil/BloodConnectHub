  usecase "View User Activity Log" as UC_UserActivityLog
}

' ============================================
' Use Cases - Role Management
' ============================================
package "Role & Permission Management" #F3E5F5 {
  usecase "Manage Roles" as UC_ManageRoles
  usecase "View All Roles" as UC_ViewRoles
  usecase "Assign Role to User" as UC_AssignRole
  usecase "Remove Role from User" as UC_RemoveRole
  usecase "Create Custom Role" as UC_CreateRole
  usecase "Update Role Permissions" as UC_UpdateRolePermissions
  usecase "Delete Role" as UC_DeleteRole
  usecase "View Role Permissions" as UC_ViewPermissions
}

