' ============================================
' Use Cases - Reports & Analytics
' ============================================
package "Reports & Analytics" #E1BEE7 {
  usecase "Access Reports Dashboard" as UC_ReportsDashboard
  
  rectangle "Donor Reports" {
    usecase "Donors by Blood Type" as UC_DonorsByBloodType
    usecase "Active vs Inactive Donors" as UC_ActiveVsInactive
    usecase "Donors by City" as UC_DonorsByCity
    usecase "Eligible Donors Report" as UC_EligibleDonors
  }
  
  rectangle "Donation Reports" {
    usecase "Donations by Period" as UC_DonationsByPeriod
    usecase "Blood Quantity by Type" as UC_BloodQuantity
    usecase "Test Results Statistics" as UC_TestResultsStats
    usecase "Most Active Donors" as UC_MostActiveDonors
  }
  
  rectangle "Inventory Reports" {
    usecase "Inventory Availability" as UC_InventoryAvailability
    usecase "Expiring Units Report" as UC_ExpiringUnitsReport
    usecase "Expired Units Report" as UC_ExpiredUnitsReport
    usecase "Consumption Rate Analysis" as UC_ConsumptionRate
    usecase "Low Inventory Alerts" as UC_LowInventoryAlerts
  }
  
  rectangle "Request Reports" {
    usecase "Requests by Status" as UC_RequestsByStatus
    usecase "Requests by Urgency" as UC_RequestsByUrgency
    usecase "Fulfillment Rate Report" as UC_FulfillmentRate
    usecase "Average Fulfillment Time" as UC_AvgFulfillmentTime
  }
  
  usecase "Generate Custom Report" as UC_CustomReport
  usecase "Schedule Automated Reports" as UC_ScheduleReports
  usecase "Export Reports (PDF/Excel)" as UC_ExportReports
  usecase "Print Reports" as UC_PrintReports
  usecase "Email Reports" as UC_EmailReports
}

